APP_NAME="LOCO TRACK"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Database Configuration (MySQL Recommended for Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loco_track
DB_USERNAME=loco_user
DB_PASSWORD=your_secure_db_password

# Session Configuration (Must be secure for SPA cookie auth)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Storage & Filesystem
FILESYSTEM_DISK=local

# Queue & Cache
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME=""

# Sanctum & SPA CORS Configuration
# Domain without protocol, comma-separated (e.g. app.yourdomain.com)
SANCTUM_STATEFUL_DOMAINS="app.yourdomain.com"
# Full URL including protocol for CORS allowed origins
FRONTEND_URL="https://app.yourdomain.com"
CORS_ALLOWED_ORIGINS="https://app.yourdomain.com"
SANCTUM_EXPIRATION=1440

# AWS S3 (Optional if using S3 filesystem disk)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false